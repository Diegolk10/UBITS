# ---------------------------------------------------------------------------
# Anthropic — SOLO servidor. Nunca prefijes esta clave con NEXT_PUBLIC_.
# ---------------------------------------------------------------------------
ANTHROPIC_API_KEY=sk-ant-...
# Modelo configurable. Debe soportar la server tool de web search 2026-02-09
# (claude-sonnet-5, claude-opus-5, claude-opus-4-8, claude-sonnet-4-6, ...).
ANTHROPIC_MODEL=claude-sonnet-5

# ---------------------------------------------------------------------------
# Supabase — persistencia compartida. Ambas variables son de servidor.
# Si las dejas vacías, la app usa un store local en ./.data/db.json
# (útil para probar sin cuenta, pero NO persiste en Vercel ni se comparte).
# ---------------------------------------------------------------------------
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...
